# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# FIREBASE / FIRESTORE SERVER-SIDE CONFIGURATION (firebase-admin)
# Project ID for Firebase Admin SDK (defaults to projectId in firebase-applet-config.json if unset)
FIREBASE_PROJECT_ID="gen-lang-client-0938695616"

# Named Firestore Database ID (defaults to firestoreDatabaseId in firebase-applet-config.json or "(default)")
FIRESTORE_DATABASE_ID="ai-studio-propspherereales-56a87e2a-86e2-4b06-88e5-824a7183839d"

# Optional Service Account credentials when running outside GCP/Cloud Run Application Default Credentials (ADC):
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Or path to Service Account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=""
