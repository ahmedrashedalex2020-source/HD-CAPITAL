rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared CRM workspace state across PC, Mobile, and embedded iframe hosts
    match /crm_state/{docId} {
      allow read, write: if true;
    }
    match /{collection}/{docId} {
      allow read, write: if collection in [
        'users',
        'roles',
        'leads',
        'leadPhones',
        'properties',
        'deals',
        'events',
        'sheetConnections',
        'syncLogs',
        'notifications',
        'settings'
      ];
    }
    match /leads/{leadId}/activities/{activityId} {
      allow read, write: if true;
    }
  }
}
