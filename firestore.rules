rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper validations for Production-Ready Firestore hardening
    function isValidUserPayload() {
      return request.resource.data.keys().hasAll(['id', 'username', 'fullName', 'roleId'])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 80;
    }

    // Shared CRM workspace state across PC, Mobile, Vercel, and embedded iframe hosts
    match /crm_state/{docId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasAny(['users', 'leads', 'roles', 'deals', 'properties', 'events']);
    }

    // Users Collection: Enforce schema validation and protect primary system admin from deletion
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUserPayload();
      allow delete: if userId != 'usr_admin';
    }

    // Core CRM Collections
    match /{collection}/{docId} {
      allow read, write: if collection in [
        'roles',
        'leads',
        'leadPhones',
        'properties',
        'deals',
        'events',
        'sheetConnections',
        'syncLogs',
        'notifications',
        'settings'
      ];
    }

    match /leads/{leadId}/activities/{activityId} {
      allow read, write: if true;
    }
  }
}
